credentials.json
secrets.yaml
secrets.yml
# .env is ignored, but timestamped copies made during merges/upgrades were not,
# leaving a file of real API keys one `git add -A` from being committed.
.env.*
!.env.example
!.env.*.example

.webhook-secret
scheduled.db

# The repo-root `store` is a symlink to whatsapp-bridge/store. A trailing-slash
# pattern only matches real directories, so the symlink itself stayed untracked
# and would have been swept up by `git add -A`. Match it without the slash too.
store
/store
scheduled.db

# Built binaries and local backups
whatsapp-bridge/whatsapp-bridge
whatsapp-bridge/whatsapp-bridge.*

# Compiled macOS STT helper (build artifact, arm64)
wa-assistant/speech-transcribe
