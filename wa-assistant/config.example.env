# wa-assistant configuration. Copy to config.env and edit.
#   cp config.example.env config.env && ./wa-assistant.py --check
#
# Real environment variables override this file, so a launchd plist or a
# one-off shell override can change behaviour without editing anything here.
# Every value below is a default — delete the lines you don't need to change.

# ---------------------------------------------------------------- bridge
BRIDGE_API=http://127.0.0.1:8080
# Relative paths resolve against this directory, so the defaults work when
# wa-assistant/ sits inside the repo.
BRIDGE_DB=../whatsapp-bridge/store/messages.db
BRIDGE_STORE=../whatsapp-bridge/store
BRIDGE_ENV_FILE=../.env
# whatsmeow's session store — read only, to learn BOTH of your identities.
BRIDGE_SESSION_DB=../whatsapp-bridge/store/whatsapp.db

# Whose messages count as "you". Leave blank — both of your identities (the
# phone-number jid and the LID) are read from whatsmeow's device row.
#
# This matters more than it sounds: which identity your self-chat is filed
# under differs BY DEVICE. On one account the laptop had it under the @lid
# (264 msgs) and the server under @s.whatsapp.net (367) — same conversation.
# Watching only one finds nothing. Set this only to add a jid we cannot see.
# Comma-separated. Find yours with:
#   sqlite3 ../whatsapp-bridge/store/messages.db \
#     "SELECT DISTINCT chat_jid FROM messages WHERE is_from_me=1 LIMIT 20;"
#SELF_JIDS=4915112345678@s.whatsapp.net,1234567890123@lid

# ---------------------------------------------------------------- session
CLAUDE_BIN=claude
CLAUDE_MODEL=claude-sonnet-5
# The session answers messages from your phone with no human at the keyboard,
# so it cannot stop to ask permission. Restrict what it may do instead — see
# the Security section of README.md and wa-dispatch/hooks/deny.py.
CLAUDE_FLAGS=--dangerously-skip-permissions --strict-mcp-config
# Where the session runs. Put a CLAUDE.md here to give it standing instructions.
WORKDIR=~/wa-assistant-workdir

POLL_SECONDS=2
REPLY_TIMEOUT=180
MAX_REPLY_CHARS=1500
# If a reply takes longer than this, send a holding message so you know it
# heard you. Set ACK_TEXT empty to disable.
ACK_AFTER_SECONDS=4

# ---------------------------------------------------------------- deeper model
# Long or research-shaped messages get a one-shot run on a stronger model in a
# separate process, so a ten-minute task doesn't block a quick question.
HEAVY_ENABLED=true
HEAVY_MODEL=claude-opus-5
HEAVY_TIMEOUT=600
HEAVY_LENGTH=280
# Triggered when the message STARTS with one of these words...
HEAVY_KEYWORDS=deep,brain,build,research,analyze,plan,design,investigate,refactor,draft,think,search,fix,process,remember,status
# ...or contains any of these characters, so you can force it deliberately.
HEAVY_TRIGGER_CHARS=🧠
#HEAVY_WORKDIR=~/wa-assistant-workdir

# ---------------------------------------------------------------- voice in (optional)
# Send a voice note, get a spoken reply. STT_CMD receives a 16kHz mono wav as
# "$1" and must print the transcript to stdout.
STT_ENABLED=false
FFMPEG_BIN=ffmpeg
# Apple SpeechAnalyzer (macOS 26+). Bundled with the OS, no model download, no
# Python. Word-perfect on English in testing, ~2.4s for a 4s clip.
#   swiftc -O speech-transcribe.swift -o speech-transcribe
# BUT: it supports 30 locales and Croatian is NOT among them (de/en/es/fr/it/
# ja/ko/pt/zh/yue only). If your voice notes are in an unsupported language it
# will return confident nonsense rather than failing, so check the list first:
#   ./speech-transcribe --help  (or see README)
#STT_CMD=./speech-transcribe "$1" en-US
#
# Local, Apple Silicon, 99 languages incl. Croatian (~1.5GB model on first run):
#STT_CMD=uv run --with parakeet-mlx python -c 'import sys;from parakeet_mlx import from_pretrained;print(from_pretrained("mlx-community/parakeet-tdt-0.6b-v2").transcribe(sys.argv[1]).text.strip())'
# Or whisper.cpp:
#STT_CMD=whisper-cli -m ~/models/ggml-base.en.bin -nt -f
# Or a hosted API via curl — see README.md.

# ---------------------------------------------------------------- voice out (optional)
# TTS_CMD receives the reply text on STDIN and an output path as "$1".
# Whatever audio it writes is converted to opus and sent as a voice note.
TTS_ENABLED=false
# Free, macOS, no key:
#TTS_CMD=sh -c 'say -v Daniel -o "$1" "$(cat)"' sh
# Prefix a typed message with this to get the answer spoken back. Voice notes
# are always answered by voice.
TTS_PREFIX=🔊

# ---------------------------------------------------------------- images (optional)
# Photos you send are handed to the deeper model with this prompt. Blank = off.
# %s is not substituted; write the full instruction, including where the files
# are. Bursts within IMAGE_DEBOUNCE seconds are treated as one batch.
IMAGE_ENABLED=false
IMAGE_DEBOUNCE=25
#IMAGE_PROMPT=I just sent images on WhatsApp. Recent .jpg files under ../whatsapp-bridge/store/media/ from the last 20 minutes (find them with find PATH -name '*.jpg' -newermt '20 minutes ago'). Read each one, extract every idea, tool and link, and append them to ~/notes/inbox-$(date +%F).md. Reply with a two-line summary. Do not message anyone.
