# whatsapp-mcp-pro — bridge and MCP server configuration.
#   cp .env.example .env
#
# Only API_KEY is required; everything else has a working default, shown as the
# value here. This file is the reference for what the code actually reads — if
# you add an env var, add it here too.
#
# .env and any .env.* copy are gitignored. Never commit a filled-in one.

# ─────────────────────────────────────────────────────────── bridge: core
# REQUIRED. The bridge refuses to start without it. openssl rand -hex 32
API_KEY=CHANGEME_USE_openssl_rand_hex_32

# Development only. Disables API authentication entirely.
DISABLE_AUTH_CHECK=false

API_PORT=8080
# 127.0.0.1 suits a local install; 0.0.0.0 in Docker; a tailnet/VPN address to
# reach the bridge from another machine. Never a public interface.
API_BIND_HOST=127.0.0.1
# CORS_ORIGINS=https://your-domain.com,https://another-domain.com

# ─────────────────────────────────────────── safety gates — read this part
# There are TWO independent send allowlists at different layers. They are NOT
# aliases: setting one leaves the other open. Set both, or know why you didn't.
#
#   1. HTTP API layer — rejects before the request reaches whatsmeow.
# SEND_ALLOWED_JIDS=1203xxxxxxxxxxxxxxx@g.us,4477xxxxxxx@s.whatsapp.net
#
#   2. whatsmeow layer — rejects at the send call itself.
#      WHATSAPP_JID_ALLOWLIST is accepted as an alias, used only if this is unset.
# WHATSAPP_ALLOWLIST_JIDS=4915112345678,1203630123456789@g.us
#
# Both take a comma-separated list. Matching is EXACT against the full JID or
# its user part, case-insensitive. There is deliberately no substring or prefix
# matching — an entry of "net" or "@" would otherwise allow every recipient.
# Unset means no restriction, which is worth changing before pointing any
# automation at this.

# Webhook URLs to private IPs are blocked by default (SSRF guard). Enable only
# if your webhook target really is localhost. Also gates the /api/download
# CDN-host check (media URLs come from the sender, so they are validated too).
DISABLE_SSRF_CHECK=false
# Media paths are confined to a fixed allowlist (store/media, /tmp, plus any
# MEDIA_ALLOWED_DIRS below). Dev escape hatch that disables the check entirely.
DISABLE_PATH_CHECK=false
# Extra directories send_file may read a local path from, comma-separated, ON TOP
# of the built-in defaults (/app/*, /tmp). Set this so an agent on this host can
# send files straight from its working tree instead of base64-staging them.
# Path traversal (`..`) is always rejected regardless of this list.
MEDIA_ALLOWED_DIRS=
# Trust X-Forwarded-For for client IP (rate limiting + audit log). Leave false
# unless the bridge sits behind a trusted reverse proxy — the header is
# client-spoofable and would otherwise defeat the rate limiter.
TRUST_PROXY_HEADERS=false

# ───────────────────────────────────────────────────────── bridge: presence
# human (default) stays offline and goes online only for a short randomised
# window around real outgoing activity. Permanent "available" is both a bot tell
# and a way to suppress push notifications on your paired phone.
# always_online restores the legacy behaviour.
WA_PRESENCE_MODE=human
PRESENCE_LINGER_MIN=8s
PRESENCE_LINGER_MAX=15s
# The periodic ping is a separate decision from the mode above, and off by default.
PRESENCE_PING_ENABLED=false
PRESENCE_PING_INTERVAL=20m

# ───────────────────────────────────────────── bridge: identity directory
# The `identities` table in messages.db: one row per person/group, with the
# hidden @lid and the phone JID already merged onto a single canonical identity.
# The bridge rebuilds it on connect, on contact/push-name events, and on this
# interval. 0 disables the ticker, leaving only the rebuild on connect.
IDENTITY_SYNC_INTERVAL=15m
# Fold chats filed under an @lid into their phone-JID twin. On by default:
# WhatsApp delivers the same conversation under either identity depending on
# route, and a split chat means search, recall and per-chat automation each see
# only half of it. Set false to leave history exactly as it arrived.
MERGE_LID_CHATS=true

# ───────────────────────────────────────────── bridge: account safety, sync
# Humanized send pacing: randomised delays + typing simulation before a send.
# Off by default; read the account-safety section of the README first.
ANTIBAN_ENABLED=false
# Pacing. Delays are randomised between min and max; typing time scales with
# message length. Defaults look like a person typing on a phone.
ANTIBAN_TEXT_DELAY_MIN=1500ms
ANTIBAN_TEXT_DELAY_MAX=4s
ANTIBAN_FEEDBACK_DELAY_MIN=500ms
ANTIBAN_FEEDBACK_DELAY_MAX=1500ms
ANTIBAN_TYPING_MS_PER_CHAR=30
# Warm-up ramps the daily send cap over this many days for a new account. Raise
# the start limit to effectively lift the cap on an aged, established one.
ANTIBAN_WARMUP_DAYS=7
ANTIBAN_WARMUP_START_LIMIT=20
ANTIBAN_WARMUP_STATE_PATH=store/antiban_warmup.json
# Pause sending when the computed risk score exceeds this (0-100).
ANTIBAN_RISK_PAUSE_THRESHOLD=70

HISTORY_SYNC_DAYS_LIMIT=365
HISTORY_SYNC_SIZE_MB=5000
STORAGE_QUOTA_MB=10240

# ──────────────────────────────────────────────────────── MCP server: core
# How the MCP server reaches the bridge. "host" or "host:port".
BRIDGE_HOST=localhost:8080
# Override only if the store is not at whatsapp-bridge/store.
# WA_STORE_PATH=/path/to/store
DEBUG=false

# Shared HTTP server (serve_http.py). Keep 127.0.0.1 unless you are deliberately
# serving other machines over a VPN/tailnet.
MCP_HOST=127.0.0.1
MCP_PORT=8082

# Scoped bearer tokens for the shared server. With neither set, auth is OFF and
# the bind address is your only wall. The read-only token can call only tools
# annotated readOnlyHint=true, enforced server-side rather than by convention.
# Generate each with: openssl rand -hex 24
# WA_MCP_FULL_TOKEN=
# WA_MCP_READONLY_TOKEN=

# Which tool groups are exposed. The shared server sets "all" automatically.
# Pro toolsets are opt-in and off by default under stdio:
#   recall  — semantic search over history   (uv sync --extra pro)
#   audio   — local voice-note transcription (uv sync --extra pro)
#   inbox   — check_inbox, "what arrived since I last asked"
# WHATSAPP_MCP_TOOLSETS=all
# Or pin an exact tool list, which overrides toolsets entirely.
# WHATSAPP_MCP_TOOLS=

# ─────────────────────────────────────────────── MCP server: transcription
# auto (default) picks the first available: mlx → faster-whisper → groq.
#   mlx             Apple Silicon, fully local, ~1.5 GB RAM
#   faster-whisper  any OS, fully local — uv sync --extra pro-cpu
#   groq            hosted, needs GROQ_API_KEY, near-zero RAM (small always-on boxes)
WHISPER_BACKEND=auto
# GROQ_API_KEY=
# MLX_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# FASTER_WHISPER_MODEL=base
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Transcribe incoming voice notes in the background and write the text into the
# message store, so speech becomes searchable by recall and readable in wa-client.
AUTO_TRANSCRIBE_VOICE=false
AUTO_TRANSCRIBE_INTERVAL=180
AUTO_TRANSCRIBE_BATCH=10
AUTO_TRANSCRIBE_MAX_AGE_DAYS=30

# ───────────────────────────────────────────────────── MCP server: recall
# cpu is deliberate: on Apple Silicon the GPU path pinned ~1 GB of Metal buffers
# it never released. On CPU the model is ~700 MB resident and stable.
RECALL_DEVICE=cpu
RECALL_INDEX_INTERVAL=600
# Unload the embedding model after this many idle seconds; 0 keeps it resident.
RECALL_MODEL_IDLE_UNLOAD_SECONDS=0

# Skip the import-time check that messages.db exists. Tests and lint only.
WA_SKIP_DB_CHECK=0
