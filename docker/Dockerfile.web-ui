# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# The web UI is a pnpm project (pnpm-lock.yaml, no package-lock.json), so
# `npm ci` has nothing to install from and fails.
RUN corepack enable && corepack prepare pnpm@10 --activate

COPY whatsapp-web-ui/package.json whatsapp-web-ui/pnpm-lock.yaml ./

RUN pnpm install --frozen-lockfile

# Copy source files
COPY whatsapp-web-ui/ ./

# Build the static export
RUN pnpm run build

# Production stage
FROM nginx:alpine

# Copy built static files
COPY --from=builder /app/out /usr/share/nginx/html

# Copy nginx config
COPY whatsapp-web-ui/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]
